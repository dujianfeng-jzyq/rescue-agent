# 复制为 .env 后按需修改。scripts/mcp-up.sh 和 scripts/dev.sh 会加载它。
# 已在 shell 里 export 的变量优先于这里的值（scripts/lib/env.sh）。
# 注意：DSH_HOME 这类 DSH_* 变量必须在 shell 里 export，写在 .env 里 DSH 不认（scripts/dev.sh 已处理）。

# ---- 基本 ----
RESCUE_HOME=/path/to/rescue-agent          # 仓库根目录；预设里的技能目录、审计日志路径都基于它

# ---- 大模型 ----
# 开发阶段：DeepSeek API（DSH 自带的 DeepSeek 提供方，读取这个变量）
DEEPSEEK_API_KEY=
# 本地化部署完成后：加载 profiles/local-llm.patch.yml，并填写以下三项（OpenAI 兼容接口）
RESCUE_LLM_BASE_URL=http://llm.internal:8000/v1
RESCUE_LLM_API_KEY=
RESCUE_LLM_MODEL=

# ---- MCP 服务 ----
RESCUE_MCP_HOST=127.0.0.1
RESCUE_MCP_TOKEN=                           # 共用令牌：留空则不鉴权（仅限本机开发）；多机部署时务必设置
# 按服务拆分的令牌（第二版，docs/design-v2.md 7.1）：设置后该服务只认它，没设置时退回 RESCUE_MCP_TOKEN。
# 演示部署要拆开：证据插件（DSH）只拿 mine_data 只读令牌；主预设和审批预检拿 actions 令牌；DSH 不拿 /sim 控制令牌。
# RESCUE_MCP_MINE_DATA_TOKEN=
# RESCUE_MCP_ACTIONS_TOKEN=
# RESCUE_MCP_MINE_ACT_TOKEN=                # rescue-mine 写入类工具（send_notice、dispatch_order、submit_treatment）的令牌，只有 guard 持有；读令牌调用它们返回 401。没设置时写入工具退回认 mine_data 的令牌（第三版）
# RESCUE_SIM_CONTROL_TOKEN=                 # 模拟矿井 /sim/ 控制接口（控制台、评测、scripts/sim.py）；没设置时同 mine_data 的令牌。guard 不持有它
RESCUE_MCP_MINE_DATA_URL=http://127.0.0.1:8101/mcp
RESCUE_MCP_ACTIONS_URL=http://127.0.0.1:8106/mcp
RESCUE_REDLINE_CHECK_URL=http://127.0.0.1:8106/redlines/check

# ---- 模拟矿井 ----
RESCUE_SIM_SCENARIO=s2-slow-oxidation
RESCUE_SIM_CONTROL_URL=http://127.0.0.1:8101/sim   # 模拟矿井控制接口地址（控制台、评测、scripts/sim.py 用；guard 和 DSH 不用，指令经 rescue-mine 的写入类工具执行）；接真实矿井时留空
# RESCUE_MINE_DATA_MODULE=rescue_mine_xxx           # 接真实矿井时，换成该矿的 mine-data 适配器模块

# ---- 知识库（RAGFlow，由其他部门部署）----
RAGFLOW_BASE_URL=                           # 留空则 kb 只用本地红线条文摘要（离线开发可用）
RAGFLOW_API_KEY=
KB_DATASETS_REGULATIONS=                    # 逗号分隔的 dataset id
KB_DATASETS_PLANS=
KB_DATASETS_CASES=
KB_SIMILARITY_THRESHOLD=0.2
KB_PAGE_SIZE=8
KB_TIMEOUT_S=10
KB_RETRIES=3                 # RAGFlow 断开连接、超时时重试几次（只读请求）

# 演示环境（make demo-up）里综采工作面的名称，缺省 1201。内部演示用现在这张矿井图：DEMO_PANEL=211016
# （地图包 var/map/mine_map.yaml 把 211016 的巷道映射到图上的名称；模拟矿井和监听器都按它改名）
# DEMO_PANEL=1201
