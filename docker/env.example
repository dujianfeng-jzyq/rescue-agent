# 演示环境的配置（发布包第一次运行 rescue-demo.sh up 时复制到 rescue-demo-data/.env；说明见 部署说明.md）。
# 改完重新运行 rescue-demo.sh up 生效。

# ── 必填 ──
# 大模型（DeepSeek 官方接口）；服务器要能访问 api.deepseek.com
DEEPSEEK_API_KEY=

# 对外地址：浏览器访问用的地址，只能是“协议://主机[:端口]/”，不能带子路径。三种写法：
#   https://demo.example.com/   有域名：自动申请证书（域名要解析到本机，且公网能访问本机 80 和 443 端口）
#   https://1.2.3.4/            只有 IP：用自签证书，浏览器第一次会提示“不安全”，点“继续访问”
#   http://10.0.0.5:8080/       不加密，只在可信内网用
# 留空：不对外，只能在服务器本机（或经 SSH 隧道）访问 127.0.0.1:13080 和 127.0.0.1:13090/console
DEMO_PUBLIC_URL=

# 浏览器登录口令（对外访问时必填，所有页面都先要输入这个口令）
DEMO_AUTH_USER=demo
DEMO_AUTH_PASSWORD=

# ── 可选 ──
# 对外端口绑定的地址（缺省所有网卡）
# DEMO_BIND=0.0.0.0
# 综采工作面名称（要与地图包 map/mine_map.yaml 对上）
# DEMO_PANEL=211016
# 模拟矿井的常态倍速（1 真实秒 = 倍速/60 矿井分钟）
# RESCUE_SIM_SPEED=60

# 知识库（RAGFlow），不设时用本地条文检索
# RAGFLOW_BASE_URL=
# RAGFLOW_API_KEY=
# KB_DATASETS_REGULATIONS=
# KB_DATASETS_PLANS=
# KB_DATASETS_CASES=

# 外部路径规划服务、火灾推演服务（试验性，服务器要能访问它们），不设时用我方估算
# RESCUE_ROUTE_SERVICE_URL=
# RESCUE_FIRE_SIM_URL=
