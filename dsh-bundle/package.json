{
  "name": "@rescue/dsh-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "煤矿应急救援智能体的 DSH bundle：人工确认与红线预检、审计、证据与火灾固定流程（第二版）、Agent 预设",
  "type": "module",
  "exports": {
    "./approval": "./lib/approval/index.js",
    "./audit": "./lib/audit/index.js",
    "./evidence": "./lib/evidence/index.js",
    "./fire-loop": "./lib/fire-loop/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "presets"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/commander.patch.yml",
        "./presets/plan.patch.yml",
        "./presets/compliance.patch.yml"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.4",
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
