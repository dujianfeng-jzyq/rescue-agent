ize":null,"standby_team":null,"params":{"gas":"N2","rate_m3_h":1734}},{"order":4,"type":"grouting","description":"向采空区注浆，覆盖浮煤、充填裂隙","roadways":[],"team_size":null,"standby_team":null,"params":{}},{"order":5,"type":"monitor","description":"处置后按本矿自然发火预测预报制度加密束管取样，观测气体变化，效果由复评判定（频次由指挥部确定）","roadways":[],"team_size":null,"standby_team":null,"params":{}}],"basis":[{"document":"矿山救援规程","article":"第98条","source":"index","note":null}],"panel":"1201"}}},"articles":[{"document":"矿山救援规程","article":"第46条","content":"矿山救援队带队指挥员应当根据应急救援方案和事故情况，组织制定矿山救援队行动方案和安全保障措施；执行灾区探察和救援任务时，应当至少有1名中队或者中队以上指挥员在现场带队。","source":"index"},{"document":"矿山救援规程","article":"第85条","content":"封闭火区应当遵守下列规定:\n（一）多条巷道需要封闭的，先封闭支巷，后封闭主巷；\n（二）火区主要进风巷和回风巷中的密闭留有通风孔，其他密闭可以不留通风孔；\n（三）选择进风巷和回风巷同时封闭的，在两处密闭上预留通风孔，封堵通风孔时统一指挥、密切配合，以最快速度同时封堵，完成密闭工作后迅速撤至安全地点；\n（四）封闭有爆炸危险火区时，先采取注入惰性气体等抑爆措施，后在安全位置构筑进、回风密闭；\n（五）封闭火区过程中，设专人检测风流和气体变化，发现瓦斯等易燃易爆气体浓度迅速增加时，所有人员立即撤到安全地点，并向现场指挥部报告。","source":"index"},{"document":"矿山救援规程","article":"第98条","content":"采空区或者巷道冒落带发生火灾，应当保持通风系统稳定，检查与火区相连的通道，防止瓦斯涌入火区。","source":"index"}]}
