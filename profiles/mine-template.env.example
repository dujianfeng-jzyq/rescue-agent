# 接入某座真实矿井时的环境变量模板。复制为 profiles/<矿名>.env，启动前 `set -a; . profiles/<矿名>.env; set +a`。
# 原则：只换 mine-data 适配器和数据源，其他服务、预设、技能不改。

RESCUE_MINE_DATA_MODULE=rescue_mine_<矿名>      # 实现 rescue_contract 契约的适配器（先跑 python -m rescue_contract.conformance <URL> 通过再上线；写入类检查（--with-actions）会真的执行动作，只在测试环境运行）
RESCUE_SIM_CONTROL_URL=                          # 留空：真实矿井没有模拟器控制接口
# RESCUE_MCP_MINE_ACT_TOKEN=                     # 适配器的写入令牌（通知、调度、处置），只有 guard 持有，适配器要实现同样的读写分离
RESCUE_SIM_SCENARIO=

# 该矿的知识库数据集（矿井预案、灾害预防和处理计划）
KB_DATASETS_PLANS=

# fire-model 阈值：该矿审定后的预警阈值文件（覆盖 thresholds.yaml 中的占位值）
# RESCUE_FIRE_THRESHOLDS=/path/to/<矿名>-thresholds.yaml

# 多机部署
RESCUE_MCP_HOST=0.0.0.0
RESCUE_MCP_TOKEN=
